<?xml version="1.0" encoding="UTF-8"?>
<!--
  Place this in the site root (next to ReconDash.html) if IIS returns
  404.3 "MIME type not allowed" when the console requests /data/*.csv.
  IIS blocks unrecognized extensions by default; this adds .csv as
  text/csv. Safe to merge into an existing web.config if the site
  already has one - just add the <mimeMap> line into its
  <staticContent> section instead of dropping this whole file in.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
    </staticContent>
  </system.webServer>
</configuration>
