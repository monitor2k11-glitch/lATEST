function Get-TlsRemediation {
    param([string]$Stage, $Cert)
    switch ($Stage) {
        'TCP'                   { 'TCP connection failed; verify port open, routing, and service running' }
        'ClientHello'           { 'TLS handshake initiation failed; check Schannel configuration and supported TLS versions on both endpoints' }
        'ServerHello'           { 'Server rejected TLS version or cipher; audit server TLS policy and cipher suite list' }
        'Certificate'           { 'Server did not present a certificate; ensure SSL/TLS is configured correctly on the server' }
        'CertificateValidation' {
            if ($Cert?.IsExpired)       { "Certificate expired; renew immediately (was valid until $($Cert.NotAfter))" }
            elseif (-not $Cert?.SanMatch) { "Hostname '$Target' not in certificate SAN or CN; reissue certificate covering this name" }
            elseif ($Cert?.NotYetValid) { 'Certificate not yet valid; check NotBefore date and system clock' }
            else                        { 'Chain validation failed; check intermediate CAs, root trust, and OCSP/CRL reachability' }
        }
        'KeyExchange'           { 'Key exchange failed; check for protocol version or cipher incompatibility' }
        default                 { 'TLS failure; check certificate, chain, server TLS policy, and Schannel event logs (Event 36871, 36874)' }
    }
}

function Invoke-TlsDiagnostics {
    param([bool]$TcpOk = $true)
    Write-CiepLog 'Starting TLS diagnostics…' -Level Info -Module TLS
    $ms  = [System.Diagnostics.Stopwatch]::StartNew()
    $out = [System.Collections.Generic.List[object]]::new()

    $tlsPorts = @($Ports | Where-Object { $_ -in @(443,636,3269,8443,5986,993,995,465) })

    if (-not $Target -or $tlsPorts.Count -eq 0) {
        $r = New-CiepResult -TestId 'TLS-SKIP' -Module TLS -Name 'TLS Tests'
        $r.Status = 'Skipped'
        $r.Description = if (-not $Target) { 'No target' } else { 'No TLS-capable ports in test set' }
        $out.Add($r); return $out
    }

    foreach ($port in $tlsPorts) {
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId "TLS-$port" -Module TLS -Name "TLS: $Target`:$port"
        $r.DependsOn = "TCP-$port"

        # Flow tracking
        $flow = [ordered]@{
            TCP                   = 'Pending'
            ClientHello           = 'Pending'
            ServerHello           = 'Pending'
            Certificate           = 'Pending'
            CertificateValidation = 'Pending'
            KeyExchange           = 'Pending'
            Finished              = 'Pending'
            ApplicationProtocol   = 'Pending'
            FirstFailedStage      = $null
        }

        $certInfo  = $null
        $chainInfo = $null
        $tlsVer    = $null
        $cipher    = $null
        $sni       = if ($Target -notmatch '^\d{1,3}(\.\d{1,3}){3}$') { $Target } else { $null }
        $client    = $null

        try {
            # TCP stage
            $client  = [System.Net.Sockets.TcpClient]::new()
            $ia      = $client.BeginConnect($Target, $port, $null, $null)
            $done    = $ia.AsyncWaitHandle.WaitOne($TimeoutSeconds * 1000, $false)
            if (-not $done) {
                $flow.TCP = 'Failed'; $flow.FirstFailedStage = 'TCP'
                throw "TCP to $Target`:$port timed out"
            }
            $client.EndConnect($ia)
            $flow.TCP = 'Passed'

            # TLS stages — permissive cert callback; we validate manually
            $certCallback = [System.Net.Security.RemoteCertificateValidationCallback]{
                param($s, $c, $ch, $e); $true
            }
            $stream    = $client.GetStream()
            $ssl       = [System.Net.Security.SslStream]::new($stream, $false, $certCallback)
            $ssl.ReadTimeout  = $TimeoutSeconds * 1000
            $ssl.WriteTimeout = $TimeoutSeconds * 1000
            $flow.ClientHello = 'InProgress'

            $protocols = [System.Security.Authentication.SslProtocols]'Tls12,Tls13'
            try {
                $ssl.AuthenticateAsClient($sni, $null, $protocols, $false)
            } catch {
                # Fallback: TLS 1.2 only
                try { $ssl.Dispose() } catch {}
                try { $client.Dispose() } catch {}
                $client = [System.Net.Sockets.TcpClient]::new()
                $client.Connect($Target, $port)
                $stream = $client.GetStream()
                $ssl    = [System.Net.Security.SslStream]::new($stream, $false, $certCallback)
                try {
                    $ssl.AuthenticateAsClient($sni, $null, [System.Security.Authentication.SslProtocols]::Tls12, $false)
                } catch {
                    $flow.ClientHello = 'Failed'
                    $flow.FirstFailedStage = 'ClientHello'
                    throw
                }
            }

            $flow.ClientHello = 'Passed'
            $flow.ServerHello = 'Passed'
            $tlsVer = $ssl.SslProtocol.ToString()
            $cipher = "$($ssl.CipherAlgorithm) / $($ssl.HashAlgorithm) / $($ssl.KeyExchangeAlgorithm)"
            $flow.Certificate = 'Passed'

            # Certificate inspection
            $raw = $ssl.RemoteCertificate
            if ($raw) {
                $cert2 = [System.Security.Cryptography.X509Certificates.X509Certificate2]$raw

                # SAN extraction
                $sans = @()
                try {
                    $sanExt = $cert2.Extensions['2.5.29.17']
                    if ($sanExt) {
                        $sans = ($sanExt.Format($false) -split '(?<=\w),\s*' |
                            ForEach-Object { $_ -replace '^DNS Name=|^IP Address=','' } |
                            Where-Object { $_ -and $_ -notmatch '^\s*$' })
                    }
                } catch {}

                # SAN / CN match
                $sanMatch = $false
                foreach ($s in $sans) {
                    try {
                        $pat = '^' + [regex]::Escape($s).Replace('\*','[^.]+') + '$'
                        if ($Target -match $pat) { $sanMatch = $true; break }
                    } catch {}
                }
                if (-not $sanMatch -and $cert2.Subject -match 'CN=([^,]+)') {
                    try {
                        $pat = '^' + [regex]::Escape($matches[1].Trim()).Replace('\*','[^.]+') + '$'
                        if ($Target -match $pat) { $sanMatch = $true }
                    } catch {}
                }

                $now        = Get-Date
                $notBefore  = $cert2.NotBefore
                $notAfter   = $cert2.NotAfter
                $daysLeft   = [Math]::Floor(($notAfter - $now).TotalDays)
                $expired    = ($now -gt $notAfter)
                $notYet     = ($now -lt $notBefore)
                $expireSoon = (-not $expired -and $daysLeft -le 30)

                $eku = try { $cert2.Extensions['2.5.29.37']?.Format($false) } catch { 'N/A' }
                $ku  = try { $cert2.Extensions['2.5.29.15']?.Format($false) } catch { 'N/A' }

                $certInfo = [PSCustomObject]@{
                    Subject      = $cert2.Subject
                    Issuer       = $cert2.Issuer
                    Thumbprint   = $cert2.Thumbprint
                    SerialNumber = $cert2.SerialNumber
                    NotBefore    = $notBefore.ToString('yyyy-MM-dd HH:mm:ss')
                    NotAfter     = $notAfter.ToString('yyyy-MM-dd HH:mm:ss')
                    DaysLeft     = $daysLeft
                    Expired      = $expired
                    NotYetValid  = $notYet
                    ExpiringSoon = $expireSoon
                    SanMatch     = $sanMatch
                    SANs         = $sans
                    EKU          = $eku
                    KeyUsage     = $ku
                    SigAlg       = $cert2.SignatureAlgorithm.FriendlyName
                    KeyBits      = try { $cert2.PublicKey.Key.KeySize } catch { 0 }
                    Version      = $cert2.Version
                }

                # Chain
                $flow.CertificateValidation = 'InProgress'
                $chain = [System.Security.Cryptography.X509Certificates.X509Chain]::new()
                $chain.ChainPolicy.RevocationMode = [System.Security.Cryptography.X509Certificates.X509RevocationMode]::Online
                $chainOk = $chain.Build($cert2)
                $chainElements = $chain.ChainElements | ForEach-Object {[PSCustomObject]@{
                    Subject = $_.Certificate.Subject
                    Issuer  = $_.Certificate.Issuer
                    Expiry  = $_.Certificate.NotAfter.ToString('yyyy-MM-dd')
                    Status  = ($_.ChainElementStatus | ForEach-Object { $_.StatusInformation.Trim() }) -join '; '
                }}
                $chainErrs = ($chain.ChainStatus | ForEach-Object { $_.StatusInformation.Trim() }) -join '; '
                $chainInfo = [PSCustomObject]@{ Valid = $chainOk; Elements = $chainElements; Errors = $chainErrs }

                # Determine overall validation result
                $valOk = $chainOk -and -not $expired -and -not $notYet -and $sanMatch
                if ($valOk) {
                    $flow.CertificateValidation = 'Passed'
                    $flow.KeyExchange           = 'Passed'
                    $flow.Finished              = 'Passed'
                    $flow.ApplicationProtocol   = 'Available'
                } else {
                    $flow.CertificateValidation = 'Failed'
                    $flow.FirstFailedStage      = 'CertificateValidation'
                    $reasons = @()
                    if ($expired)     { $reasons += "Expired $([Math]::Abs($daysLeft))d ago" }
                    if ($notYet)      { $reasons += "Not yet valid (from $($notBefore.ToString('yyyy-MM-dd')))" }
                    if (-not $sanMatch) { $reasons += "Target '$Target' not in SAN/CN" }
                    if (-not $chainOk)  { $reasons += "Chain: $chainErrs" }
                    $r.Error = $reasons -join '; '
                }
            }

            # Set result status
            if ($flow.FirstFailedStage) {
                $r.Status = 'Failed'
                $r.Description  = "TLS failed at stage: $($flow.FirstFailedStage)"
                $r.ErrorCategory = 'TLS_VALIDATION_FAILURE'
                $r.Remediation   = Get-TlsRemediation -Stage $flow.FirstFailedStage -Cert $certInfo
            } elseif ($certInfo?.ExpiringSoon) {
                $r.Status = 'Warning'
                $r.Description = "TLS OK ($tlsVer) — certificate expires in $($certInfo.DaysLeft) day(s)"
                $r.Remediation = "Renew certificate before $($certInfo.NotAfter)"
            } else {
                $r.Status = 'Passed'
                $r.Description = "TLS OK ($tlsVer) — certificate valid for $($certInfo?.DaysLeft) days"
            }

            try { $ssl.Dispose() } catch {}

        } catch {
            if (-not $flow.FirstFailedStage) {
                $flow.FirstFailedStage = if ($flow.TCP -ne 'Passed') { 'TCP' } else { 'Handshake' }
            }
            if (-not $r.Error) { $r.Error = $_.Exception.Message }
            $r.Status = 'Failed'
            $r.ErrorCategory = if ($flow.TCP -ne 'Passed') { 'TCP_FAILURE' } else { 'TLS_HANDSHAKE_FAILURE' }
            $r.Description   = "TLS failed at stage: $($flow.FirstFailedStage) — $($_.Exception.Message)"
            $r.Remediation   = Get-TlsRemediation -Stage $flow.FirstFailedStage -Cert $certInfo
        } finally {
            try { if ($client) { $client.Dispose() } } catch {}
        }

        $r.Data = [PSCustomObject]@{
            Target      = $Target
            Port        = $port
            TlsVersion  = $tlsVer
            Cipher      = $cipher
            SNI         = $sni
            Flow        = $flow
            Certificate = $certInfo
            Chain       = $chainInfo
        }
        $r.DurationMs = Get-ElapsedMs $sw
        $out.Add($r)
        Write-CiepLog "TLS $Target`:$port → $($r.Status)" -Level $(if ($r.Status -eq 'Passed') {'Debug'} else {'Warning'}) -Module TLS
    }

    $ms.Stop()
    Write-CiepLog "TLS complete in $([Math]::Round($ms.Elapsed.TotalSeconds,1))s" -Level Success -Module TLS
    return $out
}
