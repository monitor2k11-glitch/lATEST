## ═══════════════════════════════════════════════════════════════════════════════

function Import-CiepConfig {
    param([string]$Path)
    if (-not $Path -or -not (Test-Path $Path -ErrorAction SilentlyContinue)) { return @{} }
    try {
        $j = Get-Content $Path -Raw | ConvertFrom-Json
        Write-CiepLog "Config loaded: $Path" -Level Info -Module Config
        return $j
    } catch {
        Write-CiepLog "Config parse failed '$Path': $_" -Level Warning -Module Config
        return @{}
    }
}

function Merge-Config {
    param($fc)
    if (-not $fc) { return }
    if ($fc.Target      -and -not $PSBoundParameters.ContainsKey('Target'))      { $script:Target       = $fc.Target }
    if ($fc.Ports       -and -not $PSBoundParameters.ContainsKey('Ports'))       { $script:Ports        = $fc.Ports }
    if ($fc.DnsServers  -and -not $PSBoundParameters.ContainsKey('DnsServers'))  { $script:DnsServers   = $fc.DnsServers }
    if ($fc.RetryCount  -and -not $PSBoundParameters.ContainsKey('RetryCount'))  { $script:RetryCount   = $fc.RetryCount }
    if ($fc.TimeoutSeconds -and -not $PSBoundParameters.ContainsKey('TimeoutSeconds')) { $script:TimeoutSeconds = $fc.TimeoutSeconds }
    if ($fc.RunAllTests) { $Script:RunAd = $Script:RunKrb = $Script:RunLdap = $true }
    if ($fc.ServiceAccountName -and -not $PSBoundParameters.ContainsKey('ServiceAccountName')) {
        $script:ServiceAccountName = $fc.ServiceAccountName
    }
}

function Test-Inputs {
    $errs = [System.Collections.Generic.List[string]]::new()
    if ($RunAllTests) {
        $Script:RunAd  = $true
        $Script:RunKrb = $true
        $Script:RunLdap = $true
    }
    if ($RunLdapBindTest -or $Script:RunBind) { $Script:RunLdap = $true }
    if ($Target) {
        if ($Target.Length -gt 253)              { $errs.Add("Target name length exceeds 253 characters") }
        if ($Target -match '[^\w\.\-\[\]:]')     { $errs.Add("Target contains invalid characters: $Target") }
    }
    foreach ($e in $errs) { Write-CiepLog $e -Level Error -Module Validation }
    if ($errs.Count -gt 0) { throw "Validation failed with $($errs.Count) error(s)" }
}

## ═══════════════════════════════════════════════════════════════════════════════
## SECTION 4 — NETWORK MODULE
## ═══════════════════════════════════════════════════════════════════════════════

function Invoke-NetworkDiagnostics {
    Write-CiepLog 'Starting Network diagnostics…' -Level Info -Module Network
    $ms  = [System.Diagnostics.Stopwatch]::StartNew()
    $out = [System.Collections.Generic.List[object]]::new()

    ## NET-001 Adapter status
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'NET-001' -Module Network -Name 'Network Adapter Status'
    try {
        $adapters = Get-NetAdapter -ErrorAction Stop | Where-Object { $_.Status -ne 'Not Present' }
        $up       = $adapters | Where-Object { $_.Status -eq 'Up' }
        $r.Data = $adapters | ForEach-Object {[PSCustomObject]@{
            Name          = $_.Name
            Description   = $_.InterfaceDescription
            Status        = $_.Status.ToString()
            MacAddress    = $_.MacAddress
            LinkSpeedMbps = [Math]::Round($_.LinkSpeed / 1MB, 0)
            MediaType     = $_.MediaType
            Virtual       = $_.Virtual
            IfIndex       = $_.InterfaceIndex
        }}
        $r.Status      = if ($up.Count -gt 0) { 'Passed' } else { 'Failed' }
        $r.Description = if ($up.Count -gt 0) { "$($up.Count) active adapter(s)" } else { 'No active network adapters' }
        if ($r.Status -eq 'Failed') { $r.Remediation = 'Check physical cables, wireless, or virtual adapter configuration' }
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    ## NET-002 IP Configuration
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'NET-002' -Module Network -Name 'IP Configuration'
    try {
        $cfg = Get-NetIPConfiguration -ErrorAction Stop | Where-Object { $_.IPv4Address -or $_.IPv6Address }
        $r.Data = $cfg | ForEach-Object {[PSCustomObject]@{
            Interface   = $_.InterfaceAlias
            IPv4        = ($_.IPv4Address | ForEach-Object { $_.IPAddress }) -join ', '
            IPv6        = ($_.IPv6Address | Where-Object { $_.IPAddress -notmatch '^fe80' } | ForEach-Object { $_.IPAddress }) -join ', '
            GatewayIPv4 = $_.IPv4DefaultGateway?.NextHop
            GatewayIPv6 = $_.IPv6DefaultGateway?.NextHop
            DNS         = ($_.DNSServer | ForEach-Object { $_.ServerAddresses }) -join ', '
            DHCP        = ($_.NetIPv4Interface?.Dhcp -eq 'Enabled')
            Metric      = $_.NetIPv4Interface?.InterfaceMetric
        }}
        $gw = $cfg | Where-Object { $_.IPv4DefaultGateway }
        $r.Status      = if ($gw) { 'Passed' } else { 'Warning' }
        $r.Description = if ($gw) { "Gateway: $($gw[0].IPv4DefaultGateway.NextHop)" } else { 'No default gateway on any interface' }
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    ## NET-003 Route Table
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'NET-003' -Module Network -Name 'Route Table (IPv4)'
    try {
        $routes = Get-NetRoute -AddressFamily IPv4 -ErrorAction Stop | Sort-Object RouteMetric | Select-Object -First 60
        $defRoute = $routes | Where-Object { $_.DestinationPrefix -eq '0.0.0.0/0' }
        $r.Data = $routes | ForEach-Object {[PSCustomObject]@{
            Prefix    = $_.DestinationPrefix
            NextHop   = $_.NextHop
            Interface = $_.InterfaceAlias
            Metric    = $_.RouteMetric
            Protocol  = $_.Protocol.ToString()
        }}
        $r.Status      = if ($defRoute) { 'Passed' } else { 'Warning' }
        $r.Description = if ($defRoute) { "Default route via $($defRoute[0].NextHop) on $($defRoute[0].InterfaceAlias)" } else { 'No default IPv4 route' }
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    ## NET-004 ARP / Neighbour Cache
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'NET-004' -Module Network -Name 'ARP / Neighbour Cache'
    try {
        $arp = Get-NetNeighbor -AddressFamily IPv4 -ErrorAction SilentlyContinue |
               Where-Object { $_.State -notin @('Unreachable','Incomplete') } | Select-Object -First 50
        $r.Data = $arp | ForEach-Object {[PSCustomObject]@{
            IP        = $_.IPAddress
            MAC       = $_.LinkLayerAddress
            State     = $_.State.ToString()
            Interface = $_.InterfaceAlias
        }}
        $r.Status = 'Passed'; $r.Description = "$($r.Data.Count) reachable ARP entries"
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    ## NET-005 Network Profiles
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'NET-005' -Module Network -Name 'Network Profiles'
    try {
        $prof = Get-NetConnectionProfile -ErrorAction SilentlyContinue
        $r.Data = $prof | ForEach-Object {[PSCustomObject]@{
            Interface          = $_.InterfaceAlias
            Category           = $_.NetworkCategory.ToString()
            IPv4Connectivity   = $_.IPv4Connectivity.ToString()
            IPv6Connectivity   = $_.IPv6Connectivity.ToString()
            DomainAuth         = ($_.NetworkCategory -eq 'DomainAuthenticated')
        }}
        $domAuth = $prof | Where-Object { $_.NetworkCategory -eq 'DomainAuthenticated' }
        $r.Status      = if ($domAuth) { 'Passed' } else { 'Warning' }
        $r.Description = if ($domAuth) { "Domain-authenticated on $($domAuth[0].InterfaceAlias)" } else {
            "Profiles: $(($prof | ForEach-Object { $_.NetworkCategory }) -join ', ')"
        }
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    ## NET-006 Firewall Profiles
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'NET-006' -Module Network -Name 'Windows Firewall Profiles'
    try {
        $fwp = Get-NetFirewallProfile -ErrorAction Stop
        $r.Data = $fwp | ForEach-Object {[PSCustomObject]@{
            Profile         = $_.Name
            Enabled         = $_.Enabled
            DefaultInbound  = $_.DefaultInboundAction.ToString()
            DefaultOutbound = $_.DefaultOutboundAction.ToString()
            LogBlocked      = $_.LogBlocked
            LogMaxKB        = $_.LogMaxSizeKilobytes
        }}
        $on = $fwp | Where-Object { $_.Enabled }
        $r.Status = 'Passed'; $r.Description = "Firewall active on: $(($on | ForEach-Object { $_.Name }) -join ', ')"
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    if ($Target) {
        ## NET-007 ICMP Ping
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId 'NET-007' -Module Network -Name 'ICMP Ping'
        $r.DependsOn = 'Target'
        try {
            $n    = 4
            $resp = Test-Connection -ComputerName $Target -Count $n -ErrorAction SilentlyContinue -WarningAction SilentlyContinue
            $ok   = @($resp | Where-Object { $_.StatusCode -eq 0 -or $_.Status -eq 'Success' })
            $loss = [Math]::Round((($n - $ok.Count) / $n) * 100, 0)
            $lat  = $ok | ForEach-Object { if ($_.ResponseTime) {$_.ResponseTime} elseif ($_.Latency) {$_.Latency} else {0} }
            $avg  = if ($lat.Count) { [Math]::Round(($lat | Measure-Object -Average).Average, 1) } else { $null }
            $r.Data = [PSCustomObject]@{
                Target    = $Target
                Sent      = $n
                Received  = $ok.Count
                LossPct   = $loss
                AvgMs     = $avg
                MinMs     = if ($lat.Count) { ($lat | Measure-Object -Minimum).Minimum } else { $null }
                MaxMs     = if ($lat.Count) { ($lat | Measure-Object -Maximum).Maximum } else { $null }
            }
            if ($ok.Count -eq $n) {
                $r.Status = 'Passed'; $r.Description = "All $n packets received; avg ${avg}ms"
            } elseif ($ok.Count -gt 0) {
                $r.Status = 'Warning'; $r.Description = "${loss}% packet loss; avg ${avg}ms"
                $r.Remediation = 'Intermittent loss — check for filtering, congestion, or routing instability'
            } else {
                $r.Status = 'Failed'; $r.Description = "No ICMP response from $Target"
                $r.ErrorCategory = 'ICMP_NO_RESPONSE'
                $r.Remediation = 'ICMP may be firewalled; test TCP separately. Ping failure does not prove application unreachability.'
            }
        } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
        $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

        ## NET-008 Traceroute
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId 'NET-008' -Module Network -Name 'Traceroute'
        $r.DependsOn = 'Target'
        try {
            $tr   = Test-NetConnection -ComputerName $Target -TraceRoute -Hops 30 `
                    -ErrorAction SilentlyContinue -WarningAction SilentlyContinue
            $i    = 0
            $hops = $tr.TraceRoute | ForEach-Object {
                $i++
                [PSCustomObject]@{ Hop = $i; Address = if ($_ -eq '0.0.0.0') {'*'} else {$_}; Responsive = ($_ -ne '0.0.0.0') }
            }
            $r.Data = [PSCustomObject]@{
                Target      = $Target
                Hops        = $hops
                HopCount    = $hops.Count
                NonResponsive = ($hops | Where-Object { -not $_.Responsive }).Count
                Reached     = $tr.PingSucceeded
            }
            $r.Status = if ($tr.PingSucceeded) {'Passed'} elseif ($hops.Count -gt 0) {'Warning'} else {'Failed'}
            $r.Description = "$($hops.Count) hops; target $( if ($tr.PingSucceeded) {'reached'} else {'NOT reached'})"
        } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
        $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

        ## NET-009 Local Outbound Firewall Block Rules (target ports)
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId 'NET-009' -Module Network -Name 'Local Firewall Block Rules (Outbound)'
        try {
            $blockRules = [System.Collections.Generic.List[object]]::new()
            $rules = Get-NetFirewallRule -Direction Outbound -Action Block -Enabled True -ErrorAction SilentlyContinue
            foreach ($rule in $rules) {
                try {
                    $pf = $rule | Get-NetFirewallPortFilter -ErrorAction SilentlyContinue
                    if ($pf) {
                        foreach ($port in $Ports) {
                            if ($pf.RemotePort -contains $port -or $pf.RemotePort -contains 'Any') {
                                $blockRules.Add([PSCustomObject]@{
                                    Port     = $port
                                    RuleName = $rule.DisplayName
                                    Profile  = $rule.Profile.ToString()
                                })
                            }
                        }
                    }
                } catch {}
            }
            $r.Data   = $blockRules
            $r.Status = if ($blockRules.Count -eq 0) {'Passed'} else {'Warning'}
            $r.Description = if ($blockRules.Count -eq 0) {
                'No outbound block rules found for tested ports'
            } else { "$($blockRules.Count) outbound block rule(s) found for tested ports" }
            if ($blockRules.Count -gt 0) { $r.Remediation = 'Review outbound firewall block rules — they may prevent connectivity to the target' }
        } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
        $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

        ## NET-010 Active TCP Connections to target
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId 'NET-010' -Module Network -Name 'Active Connections (Local)'
        try {
            $conns = Get-NetTCPConnection -State @('Established','TimeWait','CloseWait') -ErrorAction SilentlyContinue |
                     Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,State,OwningProcess |
                     Sort-Object RemotePort | Select-Object -First 40
            $r.Data = $conns | ForEach-Object {[PSCustomObject]@{
                Local    = "$($_.LocalAddress):$($_.LocalPort)"
                Remote   = "$($_.RemoteAddress):$($_.RemotePort)"
                State    = $_.State.ToString()
                PID      = $_.OwningProcess
                SvcName  = Get-ServiceName $_.RemotePort
            }}
            $r.Status = 'Passed'; $r.Description = "$($conns.Count) active/recent TCP connection(s)"
        } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
        $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)
    }

    $ms.Stop()
    Write-CiepLog "Network complete in $([Math]::Round($ms.Elapsed.TotalSeconds,1))s" -Level Success -Module Network
    return $out
}

