## ═══════════════════════════════════════════════════════════════════════════════

function Invoke-DnsDiagnostics {
    Write-CiepLog 'Starting DNS diagnostics…' -Level Info -Module DNS
    $ms  = [System.Diagnostics.Stopwatch]::StartNew()
    $out = [System.Collections.Generic.List[object]]::new()

    # Determine resolvers
    $resolvers = if ($DnsServers -and $DnsServers.Count -gt 0) { $DnsServers } else {
        try {
            (Get-DnsClientServerAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
             Where-Object { $_.ServerAddresses } | Select-Object -First 3).ServerAddresses |
            Where-Object { $_ } | Select-Object -Unique | Select-Object -First 3
        } catch { @() }
    }
    if (-not $resolvers -or $resolvers.Count -eq 0) { $resolvers = @('8.8.8.8','1.1.1.1') }
    Write-CiepLog "DNS resolvers: $($resolvers -join ', ')" -Level Debug -Module DNS

    ## DNS-001 Server Configuration
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'DNS-001' -Module DNS -Name 'DNS Server Configuration'
    $suffixes = try { (Get-DnsClientGlobalSetting -ErrorAction SilentlyContinue).SuffixSearchList } catch { @() }
    $r.Data = [PSCustomObject]@{ Resolvers = $resolvers; SearchSuffixes = $suffixes }
    $r.Status = if ($resolvers.Count -gt 0) {'Passed'} else {'Failed'}
    $r.Description = "Resolvers: $($resolvers -join ', ')"
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    if (-not $Target) {
        Write-CiepLog 'No target — skipping target DNS lookups' -Level Debug -Module DNS
        return $out
    }

    ## Forward lookups per record type
    foreach ($type in ($RecordTypes | Where-Object { $_ -ne 'PTR' })) {
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId "DNS-$type" -Module DNS -Name "DNS Lookup: $type"
        $r.DependsOn = 'Target'
        try {
            $q = Resolve-DnsName -Name $Target -Type $type -ErrorAction SilentlyContinue -WarningAction SilentlyContinue
            if ($q) {
                $r.Status = 'Passed'
                $r.Data   = $q | ForEach-Object {[PSCustomObject]@{
                    Name  = $_.Name
                    Type  = $_.Type
                    TTL   = $_.TTL
                    Value = switch ($_.Type) {
                        'A'     { $_.IPAddress }
                        'AAAA'  { $_.IPAddress }
                        'CNAME' { $_.NameHost }
                        'MX'    { "$($_.NameExchange) (pri $($_.Preference))" }
                        'TXT'   { ($_.Strings -join ' ') }
                        'SRV'   { "$($_.NameTarget):$($_.Port) pri=$($_.Priority) wt=$($_.Weight)" }
                        'NS'    { $_.NameHost }
                        'SOA'   { "$($_.PrimaryServer) serial=$($_.SerialNumber)" }
                        default { $_.ToString() }
                    }
                }}
                $r.Description = "$($q.Count) $type record(s) for $Target"
            } else {
                $r.Status = 'Warning'; $r.Data = @()
                $r.Description = "No $type records for $Target"
            }
        } catch {
            $r.Status = 'Failed'; $r.Error = $_.Exception.Message
            $r.ErrorCategory = 'DNS_QUERY_FAILED'
            $r.Description  = "$type query failed for $Target"
            $r.Remediation  = 'Check DNS server on UDP/TCP 53, zone configuration, and replication'
        }
        $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)
    }

    ## Per-resolver A query (response-time and consistency check)
    foreach ($srv in $resolvers) {
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $tid = "DNS-RS-$($srv -replace '[\.\:]','-')"
        $r   = New-CiepResult -TestId $tid -Module DNS -Name "Resolver Query: $srv"
        try {
            $q = Resolve-DnsName -Name $Target -Type A -Server $srv `
                 -ErrorAction SilentlyContinue -WarningAction SilentlyContinue
            $r.DurationMs = Get-ElapsedMs $sw
            $addrs = $q | Where-Object { $_.IPAddress } | ForEach-Object { $_.IPAddress }
            if ($addrs) {
                $r.Status = 'Passed'
                $r.Description = "$srv → $($addrs -join ', ') ($(Get-ElapsedMs $sw)ms)"
                $r.Data = [PSCustomObject]@{ Server = $srv; Addresses = $addrs; ResponseMs = $r.DurationMs }
            } else {
                $r.Status = 'Warning'
                $r.Description = "$srv returned no A records for $Target"
                $r.Data = [PSCustomObject]@{ Server = $srv; Addresses = @(); ResponseMs = $r.DurationMs }
            }
        } catch {
            $r.DurationMs = Get-ElapsedMs $sw
            $r.Status = 'Failed'; $r.Error = $_.Exception.Message
            $r.Description = "$srv unreachable or returned error"
            $r.Remediation = "Verify $srv is accessible on UDP/TCP 53; check firewall"
            $r.Data = [PSCustomObject]@{ Server = $srv; Addresses = @(); ResponseMs = $r.DurationMs }
        }
        $out.Add($r)
    }

    ## PTR Reverse lookup
    if ($RecordTypes -contains 'PTR') {
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r  = New-CiepResult -TestId 'DNS-PTR' -Module DNS -Name 'Reverse DNS (PTR) Lookup'
        $r.DependsOn = 'DNS-A'
        try {
            $aRec = Resolve-DnsName -Name $Target -Type A -ErrorAction SilentlyContinue |
                    Where-Object { $_.IPAddress } | Select-Object -First 1
            if ($aRec) {
                $ip  = $aRec.IPAddress
                $ptr = Resolve-DnsName -Name $ip -Type PTR -ErrorAction SilentlyContinue
                if ($ptr) {
                    $ptrName = ($ptr | Select-Object -First 1).NameHost?.TrimEnd('.')
                    $match   = $ptrName -match [regex]::Escape($Target) -or
                               $Target  -match [regex]::Escape(($ptrName ?? ''))
                    $r.Status = if ($match) {'Passed'} else {'Warning'}
                    $r.Description = if ($match) { "Forward/reverse consistent: $ip ↔ $ptrName" } else {
                        "Mismatch: $ip → $ptrName (expected match for $Target)"
                    }
                    $r.Data = [PSCustomObject]@{ ForwardIP = $ip; PTR = $ptrName; Consistent = $match }
                    if (-not $match) { $r.Remediation = 'PTR mismatch may cause authentication failures with some services; align PTR with the forward name' }
                } else {
                    $r.Status = 'Warning'; $r.Description = "No PTR record for $ip"
                    $r.Data = [PSCustomObject]@{ ForwardIP = $ip; PTR = $null; Consistent = $false }
                    $r.Remediation = 'Configure a PTR record for this IP in the reverse DNS zone'
                }
            } else {
                $r.Status = 'Skipped'; $r.Description = 'PTR skipped: A record lookup returned no IP'
            }
        } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
        $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)
    }

    ## AD SRV records
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = New-CiepResult -TestId 'DNS-ADSRV' -Module DNS -Name 'Active Directory SRV Records'
    try {
        $domain = (Get-WmiObject Win32_ComputerSystem -ErrorAction SilentlyContinue)?.Domain
        if ($domain -and $domain -ne 'WORKGROUP') {
            $srvNames = @("_ldap._tcp.$domain","_kerberos._tcp.$domain","_gc._tcp.$domain","_kpasswd._tcp.$domain")
            $srvRes   = foreach ($s in $srvNames) {
                try {
                    $q = Resolve-DnsName -Name $s -Type SRV -ErrorAction SilentlyContinue
                    [PSCustomObject]@{ Record = $s; Found = ($null -ne $q); Count = @($q).Count
                        Targets = ($q | ForEach-Object { "$($_.NameTarget):$($_.Port)" }) -join ',' }
                } catch { [PSCustomObject]@{ Record = $s; Found = $false; Count = 0; Targets = '' } }
            }
            $found = ($srvRes | Where-Object { $_.Found }).Count
            $r.Status = if ($found -eq $srvRes.Count) {'Passed'} elseif ($found -gt 0) {'Warning'} else {'Failed'}
            $r.Data = $srvRes
            $r.Description = "AD SRV: $found/$($srvRes.Count) records resolved for $domain"
            if ($r.Status -eq 'Failed') { $r.Remediation = 'DNS must point at AD-integrated DNS; check _ldap/_kerberos/_gc SRV records' }
        } else {
            $r.Status = 'Skipped'; $r.Description = 'Not domain-joined; AD SRV checks skipped'
        }
    } catch { $r.Status = 'Inconclusive'; $r.Error = $_.Exception.Message }
    $r.DurationMs = Get-ElapsedMs $sw; $out.Add($r)

    $ms.Stop()
    Write-CiepLog "DNS complete in $([Math]::Round($ms.Elapsed.TotalSeconds,1))s" -Level Success -Module DNS
    return $out
}

