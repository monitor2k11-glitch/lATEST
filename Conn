#Requires -Version 5.1
<#
.SYNOPSIS
    CIEP-Lite — Connectivity Investigation and Evidence Platform

.DESCRIPTION
    Standalone Windows diagnostics platform for investigating application-support
    issues involving network, DNS, TCP, TLS, Active Directory, Kerberos, LDAP,
    and Windows service accounts.

    Produces structured JSON output, optional CSV, and a self-contained HTML report
    with interactive flow diagrams, correlation findings, and evidence links.

.PARAMETER Target
    Hostname or IP address to investigate.

.PARAMETER RecordTypes
    DNS record types to query. Default: A, AAAA, CNAME, PTR, MX, TXT, SRV.

.PARAMETER Ports
    TCP ports to test. Default: 80, 443, 389, 636, 88, 3389, 445.

.PARAMETER OutputDirectory
    Directory for all output files. Default: .\CiepResults.

.PARAMETER ConfigFile
    Path to a JSON configuration file. Values supplement command-line parameters.

.PARAMETER NoHtmlReport
    Suppress HTML report generation.

.PARAMETER GenerateCsv
    Write a CSV result file in addition to JSON.

.PARAMETER ServiceAccountName
    Service or application account to investigate.

.PARAMETER ServiceName
    Windows service name associated with the investigation.

.PARAMETER RunAdTests
    Include Active Directory diagnostic tests.

.PARAMETER RunKerberosTests
    Include Kerberos diagnostic tests.

.PARAMETER RunLdapTests
    Include LDAP connectivity tests.

.PARAMETER RunLdapBindTest
    Attempt an anonymous LDAP bind (requires -RunLdapTests; explicitly authorised use only).

.PARAMETER RunAllTests
    Enable all optional test modules.

.PARAMETER RetryCount
    Retries for transient failures, with exponential back-off. Default: 2.

.PARAMETER TimeoutSeconds
    Per-test timeout in seconds. Default: 30.

.PARAMETER OverallTimeoutMinutes
    Maximum total run time before cancellation. Default: 30.

.PARAMETER DnsServers
    Explicit DNS resolvers to query. Defaults to system-configured servers.

.PARAMETER OverrideDependencies
    Allow tests to execute even when a declared dependency has failed.

.PARAMETER NoAutoOpen
    Do not open the HTML report automatically after generation.

.PARAMETER LoadJsonFile
    Path to an existing JSON result file — opens it in the HTML viewer without running tests.

.EXAMPLE
    .\Invoke-CiepLite.ps1 -Target "app01.contoso.local" -RecordTypes A,AAAA,SRV -OutputDirectory ".\Results"

.EXAMPLE
    .\Invoke-CiepLite.ps1 -Target "app01.contoso.local" -Ports 443,8443 -RunAllTests -GenerateCsv

.EXAMPLE
    .\Invoke-CiepLite.ps1 -Target "192.168.1.50" -ServiceAccountName "svc_webapp" -ServiceName "WebAppSvc"

.EXAMPLE
    .\Invoke-CiepLite.ps1 -LoadJsonFile ".\Results\ciep-ABC123-20250101-120000.json"

.NOTES
    CIEP-Lite v1.0.0
    Exit codes: 0 = All Passed, 1 = Failures/Warnings, 2 = Script Errors, 3 = Fatal
    Some tests require elevation or Active Directory PowerShell module.
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [Parameter(Position = 0)]
    [string]$Target,

    [Parameter()]
    [ValidateSet('A','AAAA','CNAME','PTR','MX','TXT','SRV','NS','SOA')]
    [string[]]$RecordTypes = @('A','AAAA','CNAME','PTR','MX','TXT','SRV'),

    [Parameter()]
    [ValidateRange(1, 65535)]
    [int[]]$Ports = @(80, 443, 389, 636, 88, 3389, 445),

    [Parameter()]
    [string]$OutputDirectory = '.\CiepResults',

    [Parameter()]
    [string]$ConfigFile,

    [Parameter()]
    [switch]$NoHtmlReport,

    [Parameter()]
    [switch]$GenerateCsv,

    [Parameter()]
    [string]$ServiceAccountName,

    [Parameter()]
    [string]$ServiceName,

    [Parameter()]
    [switch]$RunAdTests,

    [Parameter()]
    [switch]$RunKerberosTests,

    [Parameter()]
    [switch]$RunLdapTests,

    [Parameter()]
    [switch]$RunLdapBindTest,

    [Parameter()]
    [switch]$RunAllTests,

    [Parameter()]
    [ValidateRange(0, 10)]
    [int]$RetryCount = 2,

    [Parameter()]
    [ValidateRange(5, 300)]
    [int]$TimeoutSeconds = 30,

    [Parameter()]
    [ValidateRange(1, 240)]
    [int]$OverallTimeoutMinutes = 30,

    [Parameter()]
    [string[]]$DnsServers,

    [Parameter()]
    [switch]$OverrideDependencies,

    [Parameter()]
    [switch]$NoAutoOpen,

    [Parameter()]
    [string]$LoadJsonFile
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Continue'

