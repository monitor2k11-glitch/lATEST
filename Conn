function Test-TcpPort {
    param([string]$Host, [int]$Port, [int]$TimeoutMs = 5000)
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r  = [PSCustomObject]@{
        Host = $Host; Port = $Port; Open = $false; Status = 'Unknown'
        Banner = $null; DurationMs = 0; Error = $null; SvcName = (Get-ServiceName $Port)
    }
    $client = $null
    try {
        $client  = [System.Net.Sockets.TcpClient]::new()
        $client.ReceiveTimeout = $TimeoutMs
        $client.SendTimeout    = $TimeoutMs
        $ia   = $client.BeginConnect($Host, $Port, $null, $null)
        $done = $ia.AsyncWaitHandle.WaitOne($TimeoutMs, $false)
        if ($done) {
            try {
                $client.EndConnect($ia)
                $r.Open   = $true
                $r.Status = 'Open'
                # Banner grab — plaintext-safe ports only
                if ($Port -notin @(443,636,3269,8443,5986,993,995,465)) {
                    try {
                        $stream = $client.GetStream()
                        $stream.ReadTimeout = 1500
                        $buf  = New-Object byte[] 512
                        $read = $stream.Read($buf, 0, $buf.Length)
                        if ($read -gt 0) { $r.Banner = [System.Text.Encoding]::ASCII.GetString($buf,0,$read).Trim() }
                    } catch {}
                }
            } catch [System.Net.Sockets.SocketException] {
                $se = $_.Exception -as [System.Net.Sockets.SocketException]
                $r.Status = switch ($se?.SocketErrorCode.ToString()) {
                    'ConnectionRefused' { 'Refused'  }
                    'ConnectionReset'   { 'Reset'    }
                    default             { 'ConnError' }
                }
                $r.Error = $_.Exception.Message
            }
        } else {
            $r.Status = 'Timeout'
            $r.Error  = "No response within ${TimeoutMs}ms"
            try { $client.Close() } catch {}
        }
    } catch [System.Net.Sockets.SocketException] {
        $se = $_.Exception -as [System.Net.Sockets.SocketException]
        $r.Status = switch ($se?.SocketErrorCode.ToString()) {
            'ConnectionRefused' { 'Refused'      }
            'ConnectionReset'   { 'Reset'        }
            'HostNotFound'      { 'HostNotFound' }
            default             { "SE:$($se?.SocketErrorCode)" }
        }
        $r.Error = $_.Exception.Message
    } catch {
        $r.Status = 'Error'; $r.Error = $_.Exception.Message
    } finally {
        try { if ($client) { $client.Dispose() } } catch {}
        $sw.Stop(); $r.DurationMs = Get-ElapsedMs $sw
    }
    $r
}

function Invoke-TcpDiagnostics {
    param([bool]$DnsOk = $true)
    Write-CiepLog 'Starting TCP diagnostics…' -Level Info -Module TCP
    $ms  = [System.Diagnostics.Stopwatch]::StartNew()
    $out = [System.Collections.Generic.List[object]]::new()

    if (-not $Target) {
        $r = New-CiepResult -TestId 'TCP-SKIP' -Module TCP -Name 'TCP Tests'
        $r.Status = 'Skipped'; $r.Description = 'No target specified'
        $out.Add($r); return $out
    }

    $isIp = $Target -match '^\d{1,3}(\.\d{1,3}){3}$'

    foreach ($port in $Ports) {
        $svc = Get-ServiceName $port
        $lbl = if ($svc) { "$svc ($port)" } else { "Port $port" }
        $sw  = [System.Diagnostics.Stopwatch]::StartNew()
        $r   = New-CiepResult -TestId "TCP-$port" -Module TCP -Name "TCP: $lbl"
        $r.DependsOn = 'DNS'

        if (-not $DnsOk -and -not $isIp -and -not $OverrideDependencies) {
            $r.Status = 'DependencyBlocked'
            $r.Description = "Skipped — DNS failed for '$Target' and no IP address supplied"
            $r.Remediation = 'Resolve DNS failure first, or specify the target as an IP address'
            $out.Add($r); continue
        }

        $tcp = Test-TcpPort -Host $Target -Port $port -TimeoutMs ($TimeoutSeconds * 1000)
        $r.DurationMs = $tcp.DurationMs
        $r.Data = [PSCustomObject]@{
            Host      = $Target
            Port      = $port
            SvcName   = $svc
            Status    = $tcp.Status
            Banner    = $tcp.Banner
            DurationMs = $tcp.DurationMs
        }

        switch ($tcp.Status) {
            'Open' {
                $r.Status = 'Passed'
                $r.Description = "Port $port OPEN ($($tcp.DurationMs)ms)$(if ($tcp.Banner){" — Banner: $($tcp.Banner.Substring(0,[Math]::Min(80,$tcp.Banner.Length)))"})"
            }
            'Timeout' {
                $r.Status = 'Failed'; $r.ErrorCategory = 'TCP_TIMEOUT'
                $r.Description  = "Port $port TIMED OUT on $Target after $($tcp.DurationMs)ms"
                $r.Remediation  = 'Timeout indicates silent drop: check ACL, perimeter firewall, routing, or whether the service is listening'
                $r.Retryable    = $true
            }
            'Refused' {
                $r.Status = 'Failed'; $r.ErrorCategory = 'TCP_REFUSED'
                $r.Description  = "Port $port REFUSED on $Target (RST received — host is reachable)"
                $r.Remediation  = 'Connection refused means no service is listening on this port, or it actively rejected. This is NOT a firewall drop.'
                $r.Retryable    = $false
            }
            'Reset' {
                $r.Status = 'Failed'; $r.ErrorCategory = 'TCP_RESET'
                $r.Description  = "Port $port RESET by $Target"
                $r.Remediation  = 'RST may be from the service, firewall injection, or load balancer'
                $r.Retryable    = $false
            }
            'HostNotFound' {
                $r.Status = 'Failed'; $r.ErrorCategory = 'HOST_NOT_FOUND'
                $r.Description  = "Host '$Target' not resolved during TCP test"
                $r.Remediation  = 'DNS resolution failed during TCP test — fix DNS before retrying'
            }
            default {
                $r.Status = 'Inconclusive'
                $r.Description = "Port $port — status: $($tcp.Status)"
            }
        }
        if ($tcp.Error) { $r.Error = $tcp.Error }
        $out.Add($r)
        Write-CiepLog "$lbl → $($r.Status)" -Level $(if ($r.Status -eq 'Passed') {'Debug'} else {'Warning'}) -Module TCP
    }

    $ms.Stop()
    Write-CiepLog "TCP complete in $([Math]::Round($ms.Elapsed.TotalSeconds,1))s" -Level Success -Module TCP
    return $out
}

