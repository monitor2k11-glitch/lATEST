function Write-CiepLog {
    param(
        [string]$Message,
        [ValidateSet('Info','Warning','Error','Debug','Success')]
        [string]$Level = 'Info',
        [string]$Module = 'Core'
    )
    $ts  = (Get-Date).ToString('HH:mm:ss.fff')
    $col = switch ($Level) {
        'Warning' { 'Yellow'   }
        'Error'   { 'Red'      }
        'Debug'   { 'DarkGray' }
        'Success' { 'Green'    }
        default   { 'Cyan'     }
    }
    $line = "[$ts][$Level][$Module] $Message"
    $Script:LogBuffer.Add($line)
    Write-Host $line -ForegroundColor $col
}

function New-CiepResult {
    param(
        [string]$TestId,
        [string]$Module,
        [string]$Name,
        [string]$Status        = 'Inconclusive',
        [string]$Description   = '',
        [object]$Data          = $null,
        [string]$Error         = '',
        [string]$ErrorCategory = '',
        [string]$Remediation   = '',
        [bool]$Retryable       = $false,
        [string]$DependsOn     = ''
    )
    [PSCustomObject]@{
        TestId        = $TestId
        Module        = $Module
        Name          = $Name
        Status        = $Status
        Description   = $Description
        Data          = $Data
        Error         = $Error
        ErrorCategory = $ErrorCategory
        Remediation   = $Remediation
        Retryable     = $Retryable
        DependsOn     = $DependsOn
        Timestamp     = (Get-Date -Format 'yyyy-MM-ddTHH:mm:ss.fffZ')
        DurationMs    = 0
    }
}

function New-CiepFinding {
    param(
        [string]$RuleId,
        [string]$Title,
        [string]$Detail,
        [ValidateSet('Critical','High','Medium','Low','Info')]
        [string]$Severity    = 'Medium',
        [ValidateSet('High','Medium','Low')]
        [string]$Confidence  = 'Medium',
        [string[]]$EvidenceRefs  = @(),
        [string]$Remediation = '',
        [string[]]$Limitations   = @()
    )
    [PSCustomObject]@{
        RuleId       = $RuleId
        Title        = $Title
        Detail       = $Detail
        Severity     = $Severity
        Confidence   = $Confidence
        EvidenceRefs = $EvidenceRefs
        Remediation  = $Remediation
        Limitations  = $Limitations
        Timestamp    = (Get-Date -Format 'yyyy-MM-ddTHH:mm:ss.fffZ')
    }
}

function Write-AuditRecord {
    param([string]$Action, [string]$Detail = '')
    $ts   = (Get-Date -Format 'yyyy-MM-ddTHH:mm:ss.fffZ')
    $user = try { "$env:USERDOMAIN\$env:USERNAME" } catch { $env:USERNAME }
    $Script:AuditLines.Add("$ts|$($Script:RunId)|$user|$env:COMPUTERNAME|$Action|$Detail")
}

function Invoke-WithRetry {
    param(
        [scriptblock]$ScriptBlock,
        [int]$MaxRetries = 2,
        [int]$BaseDelayMs = 1000,
        [string]$TestName = 'Test'
    )
    $attempt = 0
    $lastErr  = $null
    while ($attempt -le $MaxRetries) {
        try { return (& $ScriptBlock) }
        catch {
            $lastErr = $_
            $attempt++
            if ($attempt -le $MaxRetries) {
                $wait = [int]($BaseDelayMs * [Math]::Pow(2, $attempt - 1))
                Write-CiepLog "Retry $attempt/$MaxRetries for '$TestName' after ${wait}ms" -Level Debug
                Start-Sleep -Milliseconds $wait
            }
        }
    }
    throw $lastErr
}

function Get-ElapsedMs { param([System.Diagnostics.Stopwatch]$sw) [Math]::Round($sw.Elapsed.TotalMilliseconds,1) }

function Test-IsElevated {
    $id  = [System.Security.Principal.WindowsIdentity]::GetCurrent()
    $p   = [System.Security.Principal.WindowsPrincipal]$id
    $p.IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Get-ServiceName { param([int]$Port) $Script:KnownPorts[$Port] }

