# Domain context — populated by AD module
$Script:DomainName = $null
$Script:PrimaryDC  = $null

# Mutable flag copies (allows conditional modules to enable each other)
$Script:RunAd      = $RunAdTests.IsPresent
$Script:RunKrb     = $RunKerberosTests.IsPresent
$Script:RunLdap    = $RunLdapTests.IsPresent
$Script:RunBind    = $RunLdapBindTest.IsPresent

$Script:ExitCodes = @{ AllPassed = 0; Failures = 1; Errors = 2; Fatal = 3 }

$Script:AdPorts = [ordered]@{
    DNS      = 53
    Kerberos = 88
    RPC      = 135
    NetBIOS  = 139
    LDAP     = 389
    SMB      = 445
    KPasswd  = 464
    LDAPS    = 636
    GC       = 3268
    GCSSL    = 3269
}

$Script:KnownPorts = @{
    21=('FTP');22=('SSH/SFTP');23=('Telnet');25=('SMTP');53=('DNS');
    80=('HTTP');88=('Kerberos');110=('POP3');135=('MS-RPC');139=('NetBIOS');
    143=('IMAP');389=('LDAP');443=('HTTPS');445=('SMB');464=('Kerberos-Pwd');
    636=('LDAPS');993=('IMAPS');995=('POP3S');1433=('MSSQL');1521=('Oracle');
    3268=('LDAP-GC');3269=('LDAPS-GC');3389=('RDP');5985=('WinRM-HTTP');
    5986=('WinRM-HTTPS');8080=('HTTP-Alt');8443=('HTTPS-Alt')
